# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Tor Configuration
# Для Tor Browser используйте: socks5://127.0.0.1:9150
# Для Tor daemon используйте: socks5://127.0.0.1:9050
TOR_PROXY=socks5://127.0.0.1:9150
TOR_TIMEOUT=60
TOR_CONNECTION_TIMEOUT=120  # Для первого подключения (установка цепочки узлов)

# Scraping Configuration
MAX_THREADS=10
SCRAPE_TIMEOUT=15
MAX_RESULTS_PER_ENGINE=10

# LLM Configuration
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

